; [ "application_version" ; Get ( ApplicationVersion ) ; JSONString ]
; [ "fmide_release" ; $fmide_release ; JSONString ]
) ; JSONObject ]
)
===
[+].End If
[+].Get File Exists
[:]..file_path = == $output_file_path
[:]..target = "$bridge_exists"
[+].Set.$bridge_error = ===
JSONSetElement ( "{}"
