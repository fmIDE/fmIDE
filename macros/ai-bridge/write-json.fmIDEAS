JSONSetElement ( "{}"
; [ "kind" ; Case ( $$fmide_get_last_error ; "fmide" ; "" ) ; JSONString ]
; [ "code" ; $$fmide_get_last_error ; JSONNumber ]
; [ "message" ; "Open output file" ; JSONString ]
