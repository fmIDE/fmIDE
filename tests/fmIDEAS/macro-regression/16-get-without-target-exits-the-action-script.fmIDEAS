[+].Set Error Capture = 1
[+].fmIDE Define Macro
[:]..macro_name = == "fmIDE_Test.MacroRegression.NoTarget"
[:]..code = == "[+].Exit Script = == 9"
[+].If = == $$fmide_get_last_error
[+].Exit Script = == JSONSetElement ( "{}" ; ["stage" ; "fixture setup" ; JSONString] ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["detail" ; $$fmide_get_last_error_detail ; JSONString] )
[+].End If
[+].Set
[:]..target = "$$fmIDE_Test"
[:]..calculation = == "unchanged"
#@test
[+].fmIDE Get Macro.fmIDE_Test.MacroRegression.NoTarget
#@endtest
[+].Set
[:]..target = "$$fmIDE_Test"
[:]..calculation = == "ran"
[+].Exit Script = == "unexpected continuation"
