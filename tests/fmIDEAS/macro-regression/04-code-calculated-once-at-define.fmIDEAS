[+].Set Error Capture = 1
[+].Set
[:]..target = "$mr_calls"
[:]..calculation = == 0
[+].Set
[:]..target = "$mr_code"
[:]..calculation = == "[+].Exit Script = == 23"
#@test
[+].fmIDE Define Macro
[:]..macro_name = == "fmIDE_Test.MacroRegression.CodeOnce"
[:]..code = == Let ( $mr_calls = $mr_calls + 1 ; $mr_code )
[+].If = == $$fmide_get_last_error
[+].Exit Script = == JSONSetElement ( "{}" ; ["stage" ; "define" ; JSONString] ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["detail" ; $$fmide_get_last_error_detail ; JSONString] )
[+].End If
[+].fmIDE Get Macro
[:]..macro_name = == "fmIDE_Test.MacroRegression.CodeOnce"
[:]..target = "$mr_macro"
#@endtest
[+].Exit Script = == JSONSetElement ( "{}" ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["calls" ; $mr_calls ; JSONNumber] ; ["code" ; JSONGetElement ( $mr_macro ; "code" ) ; JSONString] )
