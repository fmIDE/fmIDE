[+].Set Error Capture = 1
[+].fmIDE Define Macro
[:]..macro_name = == "fmIDE_Test.MacroRegression.Explicit.macro_name"
[:]..script = == "[+].Exit Script = == 39"
[+].If = == $$fmide_get_last_error
[+].  Exit Script = == JSONSetElement ( "{}" ; ["stage" ; "fixture setup" ; JSONString] ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["detail" ; $$fmide_get_last_error_detail ; JSONString] )
[+].End If
#@test
[+].fmIDE Run Macro
[:]..macro_name = == "fmIDE_Test.MacroRegression.Explicit.macro_name"
#@endtest
[+].Exit Script = == JSONSetElement ( "{}" ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["result" ; Get ( ScriptResult ) ; JSONString] )
