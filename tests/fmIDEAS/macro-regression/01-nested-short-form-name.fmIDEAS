[+].Set Error Capture = 1
#@test
[+].fmIDE Define Macro.fmIDE_Test.MacroRegression.Nested.Invoice.Print = == "[+].Exit Script = == \"nested\""
[+].If = == $$fmide_get_last_error
[+].  Exit Script = == JSONSetElement ( "{}" ; ["stage" ; "define" ; JSONString] ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["detail" ; $$fmide_get_last_error_detail ; JSONString] )
[+].End If
[+].fmIDE Get Macro
[:]..macro_name = == "fmIDE_Test.MacroRegression.Nested.Invoice.Print"
#@endtest
