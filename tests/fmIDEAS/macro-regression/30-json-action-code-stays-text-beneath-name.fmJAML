[+].Set Error Capture = 1
#@test
[+].fmIDE Define Macro.fmIDE_Test.MacroRegression.JsonCode = == "[{\"Exit Script\":\"37\"}]"
[+].If = == $$fmide_get_last_error
[+].Exit Script = == JSONSetElement ( "{}" ; ["stage" ; "define" ; JSONString] ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["detail" ; $$fmide_get_last_error_detail ; JSONString] )
[+].End If
[+].fmIDE Run Macro
[:]..macro_name = == "fmIDE_Test.MacroRegression.JsonCode"
#@endtest
[+].Exit Script = == JSONSetElement ( "{}" ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["result" ; Get ( ScriptResult ) ; JSONString] )
