[+].Set Error Capture = 1
[+].Set
[:]..target = "$pd_id"
[:]..calculation = == "fmIDE_Test.PersistentRegression." & Get ( UUID )
[+].If = == not IsEmpty ( FilterValues ( ListPersistentDataIDs ( "fmIDE" ) ; $pd_id ) )
[+].Exit Script = == "Fixture collision: no existing resource will be modified"
[+].End If
[+].Set
[:]..target = "$pd_value"
[:]..calculation = == "Café \"quotes\" \\ path" & Char ( 13 ) & "{\"looks\":\"like JSON\"} → preserved"
#@test
[+].Configure Persistent Data
[:]..instance_id = == $pd_id
[:]..calculation = == $pd_value
#@endtest
[+].Set
[:]..target = "$pd_result"
[:]..calculation = == JSONSetElement ( "{}" ; ["error" ; $$fmide_get_last_error ; JSONNumber] ; ["present" ; not IsEmpty ( FilterValues ( ListPersistentDataIDs ( "fmIDE" ) ; $pd_id ) ) ; JSONBoolean] ; ["exact" ; Exact ( GetPersistentData ( "fmIDE" ; $pd_id ) ; $pd_value ) ; JSONBoolean] )
[+].Set
[:]..target = "$pd_cleanup_error"
[:]..calculation = == 0
[+].If = == not IsEmpty ( FilterValues ( ListPersistentDataIDs ( "fmIDE" ) ; $pd_id ) )
[+].Configure Persistent Data
[:]..instance_id = == $pd_id
[:]..delete = == 1
[+].Set
[:]..target = "$pd_cleanup_error"
[:]..calculation = == $$fmide_get_last_error
[+].End If
[+].Exit Script = == JSONSetElement ( $pd_result ; ["cleanupError" ; $pd_cleanup_error ; JSONNumber] ; ["cleaned" ; not ( not IsEmpty ( FilterValues ( ListPersistentDataIDs ( "fmIDE" ) ; $pd_id ) ) ) ; JSONBoolean] )
