# Canonical file_path, legacy alias, precedence and one evaluation. Issue #210.
[+].Set Error Capture = == 1
[+].Set.$fp_checks = == "{}"
[+].Set.$fp_root = == Get ( TemporaryPath ) & "fmide-file-path-" & Get ( UUID ) & "/"

# canonical
[+].Set.$fp_path = == $fp_root & "canonical/fmIDE.fmp12"
[+].Save a Copy as
[:]..file_path = == $fp_path
[:]..by = "clone"
[:]..create_folders = == 1
[+].If = == $$fmide_get_last_error
[+].Exit Script = == JSONSetElement ( "{}" ; ["ok" ; 0 ; JSONBoolean] ; ["stage" ; "prepare canonical" ; JSONString] ; ["error" ; $$fmide_get_last_error ; JSONNumber] )
[+].End If
[+].Set.$fp_calls = == 0
[+].Set.$fp_unused = == 0
#@test
[+].Recover File
[:]..file_path = == Let ( $fp_calls = $fp_calls + 1 ; $fp_path )
[:]..with_dialog = == 0
#@endtest
[+].Set.$fp_error = == $$fmide_get_last_error
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "canonical_error" ; $fp_error = 0 ; JSONBoolean )
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "canonical_once" ; $fp_calls = 1 and $fp_unused = 0 ; JSONBoolean )
[+].Set.$fp_recovered = == Substitute ( $fp_path ; "fmIDE.fmp12" ; "fmIDE Recovered.fmp12" )
[+].Get File Exists
[:]..file_path = == $fp_recovered
[:]..target = "$fp_exists"
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "canonical_result" ; $fp_exists = 1 and $$fmide_get_last_error = 0 ; JSONBoolean )
[+].Delete File
[:]..file_path = == $fp_path
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "canonical_cleanup_source" ; $$fmide_get_last_error = 0 ; JSONBoolean )
[+].If = == $fp_exists
[+].Delete File
[:]..file_path = == $fp_recovered
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "canonical_cleanup_recovered" ; $$fmide_get_last_error = 0 ; JSONBoolean )
[+].End If

# legacy
[+].Set.$fp_path = == $fp_root & "legacy/fmIDE.fmp12"
[+].Save a Copy as
[:]..file_path = == $fp_path
[:]..by = "clone"
[:]..create_folders = == 1
[+].If = == $$fmide_get_last_error
[+].Exit Script = == JSONSetElement ( "{}" ; ["ok" ; 0 ; JSONBoolean] ; ["stage" ; "prepare legacy" ; JSONString] ; ["error" ; $$fmide_get_last_error ; JSONNumber] )
[+].End If
[+].Set.$fp_calls = == 0
[+].Set.$fp_unused = == 0
#@test
[+].Recover File
[:]..file = == Let ( $fp_calls = $fp_calls + 1 ; $fp_path )
[:]..with_dialog = == 0
#@endtest
[+].Set.$fp_error = == $$fmide_get_last_error
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "legacy_error" ; $fp_error = 0 ; JSONBoolean )
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "legacy_once" ; $fp_calls = 1 and $fp_unused = 0 ; JSONBoolean )
[+].Set.$fp_recovered = == Substitute ( $fp_path ; "fmIDE.fmp12" ; "fmIDE Recovered.fmp12" )
[+].Get File Exists
[:]..file_path = == $fp_recovered
[:]..target = "$fp_exists"
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "legacy_result" ; $fp_exists = 1 and $$fmide_get_last_error = 0 ; JSONBoolean )
[+].Delete File
[:]..file_path = == $fp_path
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "legacy_cleanup_source" ; $$fmide_get_last_error = 0 ; JSONBoolean )
[+].If = == $fp_exists
[+].Delete File
[:]..file_path = == $fp_recovered
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "legacy_cleanup_recovered" ; $$fmide_get_last_error = 0 ; JSONBoolean )
[+].End If

# precedence
[+].Set.$fp_path = == $fp_root & "precedence/fmIDE.fmp12"
[+].Save a Copy as
[:]..file_path = == $fp_path
[:]..by = "clone"
[:]..create_folders = == 1
[+].If = == $$fmide_get_last_error
[+].Exit Script = == JSONSetElement ( "{}" ; ["ok" ; 0 ; JSONBoolean] ; ["stage" ; "prepare precedence" ; JSONString] ; ["error" ; $$fmide_get_last_error ; JSONNumber] )
[+].End If
[+].Set.$fp_calls = == 0
[+].Set.$fp_unused = == 0
#@test
[+].Recover File
[:]..file_path = == Let ( $fp_calls = $fp_calls + 1 ; $fp_path )
[:]..file = == Let ( $fp_unused = $fp_unused + 1 ; $fp_root & "unused.txt" )
[:]..with_dialog = == 0
#@endtest
[+].Set.$fp_error = == $$fmide_get_last_error
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "precedence_error" ; $fp_error = 0 ; JSONBoolean )
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "precedence_once" ; $fp_calls = 1 and $fp_unused = 0 ; JSONBoolean )
[+].Set.$fp_recovered = == Substitute ( $fp_path ; "fmIDE.fmp12" ; "fmIDE Recovered.fmp12" )
[+].Get File Exists
[:]..file_path = == $fp_recovered
[:]..target = "$fp_exists"
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "precedence_result" ; $fp_exists = 1 and $$fmide_get_last_error = 0 ; JSONBoolean )
[+].Delete File
[:]..file_path = == $fp_path
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "precedence_cleanup_source" ; $$fmide_get_last_error = 0 ; JSONBoolean )
[+].If = == $fp_exists
[+].Delete File
[:]..file_path = == $fp_recovered
[+].Set.$fp_checks = == JSONSetElement ( $fp_checks ; "precedence_cleanup_recovered" ; $$fmide_get_last_error = 0 ; JSONBoolean )
[+].End If
[+].Exit Script = == Let ( [ keys = JSONListKeys ( $fp_checks ; "" ) ; ok = While ( [ i = 1 ; ok = 1 ] ; i ≤ ValueCount ( keys ) ; [ ok = ok and JSONGetElement ( $fp_checks ; GetValue ( keys ; i ) ) ; i = i + 1 ] ; ok ) ] ; JSONSetElement ( "{}" ; ["ok" ; ok ; JSONBoolean] ; ["checks" ; $fp_checks ; JSONObject] ) )
